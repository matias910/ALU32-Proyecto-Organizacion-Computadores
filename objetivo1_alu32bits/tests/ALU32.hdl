// ALU32.hdl
//
// ALU de 32 bits construida componiendo dos chips ALU estandar de 16 bits
// (proyecto 2 de Nand2Tetris), que comparten los mismos seis bits de control
// (zx, nx, zy, ny, f, no). El chip ALU se usa como caja negra: no se modifica.
//
// ---------------------------------------------------------------------------
// RESTRICCIONES DE LA HERRAMIENTA (no del diseño)
// ---------------------------------------------------------------------------
// 1. El Hardware Simulator no admite pines de mas de 16 bits. Por eso cada
//    valor de 32 bits se parte en dos pines de 16 (mitad baja / mitad alta).
//
// 2. El simulador no permite recortar bits (sub-bus) de una señal INTERNA:
//    "sub bus of an internal node may not be used". Solo se pueden recortar
//    pines IN/OUT del chip o las salidas de una PARTE en el momento de
//    conectarlas. Por eso las banderas y el bit de signo se extraen en la
//    propia conexion de salida (out[15]=..., out[0..7]=...) y no guardando
//    la señal para recortarla despues.
//
// ---------------------------------------------------------------------------
// RESTRICCION DE LA INTERFAZ DEL CHIP ALU (se documenta, no se corrige)
// ---------------------------------------------------------------------------
// El chip ALU del curso no expone su acarreo de salida. Al componer dos ALU
// de 16 bits, el acarreo del bit 15 al bit 16 se pierde. No se puede leer:
// hay que RECONSTRUIRLO desde afuera con logica adicional. Ese costo en
// compuertas y en retardo es el argumento central del analisis de viabilidad
// (ver docs/informe_final.md, seccion 2.2).
//
// ---------------------------------------------------------------------------
// RECONSTRUCCION DEL ACARREO
// ---------------------------------------------------------------------------
// Identidad del sumador completo, escrita para no necesitar el carry-in:
//
//     carry = (a15 AND b15) OR ((a15 XOR b15) AND NOT suma15)
//
// Dos detalles que la hacen valida para las 18 operaciones:
//
//   a) a15 y b15 son los bits 15 de los operandos EFECTIVOS, es decir
//      despues de aplicar zx/nx/zy/ny. Usar los operandos crudos da un
//      acarreo incorrecto en toda operacion que ponga en cero o niegue un
//      operando (x-1, y-1, la constante 0, la constante -1, ...).
//
//   b) suma15 es el bit de suma REAL. Cuando no=1 la ALU expone NOT(suma),
//      asi que el bit visible se invierte para recuperarlo: suma15 se
//      obtiene con XOR contra no.
//
// Correccion de la mitad alta, segun lo que esa mitad esta mostrando:
//   - si no=0 muestra la suma s        -> la correccion es s+1  (Inc16)
//   - si no=1 muestra NOT(s), y como
//     NOT(s+1) = NOT(s) - 1            -> la correccion es restar 1
//
// ALCANCE: correcto para las 18 operaciones estandar de la ALU.

CHIP ALU32 {
    IN
        xLow[16], xHigh[16],
        yLow[16], yHigh[16],
        zx, nx, zy, ny,
        f, no;
    OUT
        outLow[16], outHigh[16],
        zr, ng;

    PARTS:
    // ---- Mitad baja (bits 0..15) ----
    // La salida se conecta de una vez al pin OUT y, en paralelo, se extraen
    // el bit de signo y los dos bytes que necesita la bandera zr.
    ALU(x=xLow, y=yLow, zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
        out=outLow,
        out[15]=lowSum15,
        out[0..7]=lowByte0,
        out[8..15]=lowByte1);

    // ---- Mitad alta (bits 16..31), todavia sin corregir ----
    ALU(x=xHigh, y=yHigh, zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
        out=highRaw);

    // ---- Operandos EFECTIVOS del bit 15 de la mitad baja ----
    // Se replica sobre un solo bit lo que la ALU hace internamente con el
    // operando completo: zx/zy lo ponen en cero, nx/ny lo niegan.
    Not(in=zx, out=notZx);
    And(a=xLow[15], b=notZx, out=x15zeroed);
    Xor(a=x15zeroed, b=nx, out=x15);

    Not(in=zy, out=notZy);
    And(a=yLow[15], b=notZy, out=y15zeroed);
    Xor(a=y15zeroed, b=ny, out=y15);

    // ---- Reconstruccion del acarreo del bit 15 al bit 16 ----
    And(a=x15, b=y15, out=bothOnes);
    Xor(a=x15, b=y15, out=exactlyOne);
    Xor(a=lowSum15, b=no, out=sum15Real);
    Not(in=sum15Real, out=notSum15);
    And(a=exactlyOne, b=notSum15, out=carryFromSum);
    Or(a=bothOnes, b=carryFromSum, out=rawCarry);

    // Solo tiene sentido cuando la operacion es realmente una suma (f=1).
    And(a=f, b=rawCarry, out=carry);

    // ---- Correccion sobre la mitad alta ----
    // Si no=0 la mitad alta muestra la suma: se le suma 1.
    // Si no=1 la mitad alta muestra NOT(suma), y como
    // NOT(s+1) = NOT(s)-1, la correccion es RESTAR 1.
    Inc16(in=highRaw, out=highPlusOne);
    Not16(in=highRaw, out=nHigh);
    Inc16(in=nHigh, out=nHighInc);
    Not16(in=nHighInc, out=highMinusOne);
    Mux16(a=highPlusOne, b=highMinusOne, sel=no, out=highCorrected);
    Mux16(a=highRaw, b=highCorrected, sel=carry,
          out=outHigh,
          out[15]=ng,
          out[0..7]=highByte0,
          out[8..15]=highByte1);

    // ---- zr: 1 solo si los 32 bits del resultado son cero ----
    Or8Way(in=lowByte0,  out=any0);
    Or8Way(in=lowByte1,  out=any1);
    Or8Way(in=highByte0, out=any2);
    Or8Way(in=highByte1, out=any3);
    Or(a=any0, b=any1, out=anyLow);
    Or(a=any2, b=any3, out=anyHigh);
    Or(a=anyLow, b=anyHigh, out=anyBitSet);
    Not(in=anyBitSet, out=zr);
}
