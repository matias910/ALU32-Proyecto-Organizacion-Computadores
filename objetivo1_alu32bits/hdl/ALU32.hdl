// ALU32.hdl
CHIP ALU32 {
    IN
        x[32], y[32],
        zx, nx, zy, ny,
        f, no;
    OUT
        out[32],
        zr, ng;

    PARTS:
    // Low 16 bits: standard ALU
    ALU(x=x[0..15], y=y[0..15], zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
        out=lowOut, zr=zrLow, ng=ngLow);

    // High 16 bits: computed independently first ("raw")
    ALU(x=x[16..31], y=y[16..31], zx=zx, nx=nx, zy=zy, ny=ny, f=f, no=no,
        out=highRaw, zr=zrHighRaw, ng=ngHighRaw);

    // --- Carry recovery for bit 15 of the low addition ---
    And(a=x[15], b=y[15], out=andBit15);
    Xor(a=x[15], b=y[15], out=xorBit15);
    Not(in=lowOut[15], out=notSum15);
    And(a=xorBit15, b=notSum15, out=carryTerm);
    Or(a=andBit15, b=carryTerm, out=rawCarry);

    // Only apply it when the selected op is exactly x+y (f=1, no=0).
    And(a=f, b=rawCarry, out=carryIfF);
    Not(in=no, out=notNo);
    And(a=carryIfF, b=notNo, out=carry);

    // --- Apply +1 correction to high half and output to highOut + out[16..31] ---
    Inc16(in=highRaw, out=highIncremented);
    Mux16(a=highRaw, b=highIncremented, sel=carry, out=highOut, out=out[16..31]);

    // Low half passes straight through to out[0..15]
    And16(a=lowOut, b=lowOut, out=out[0..15]);

    // --- ng: sign bit calculated from internal bus highOut[15] ---
    And(a=highOut[15], b=highOut[15], out=ng);

    // --- zr: calculated using internal buses lowOut and highOut ---
    Or8Way(in=lowOut[0..7], out=zrA);
    Or8Way(in=lowOut[8..15], out=zrB);
    Or8Way(in=highOut[0..7], out=zrC);
    Or8Way(in=highOut[8..15], out=zrD);
    Or(a=zrA, b=zrB, out=zrAB);
    Or(a=zrC, b=zrD, out=zrCD);
    Or(a=zrAB, b=zrCD, out=anyBitSet);
    Not(in=anyBitSet, out=zr);
}
