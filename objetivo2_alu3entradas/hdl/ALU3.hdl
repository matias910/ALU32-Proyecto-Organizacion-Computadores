// ALU3.hdl
CHIP ALU3 {
    IN
        x[16], y[16], z[16],
        opcode[3];

    OUT
        out[16],
        zr, ng;

    PARTS:
    // Subexpresiones compartidas
    And16(a=x, b=y, out=xyAnd);
    Or16(a=x, b=y, out=xyOr);
    Add16(a=x, b=y, out=xySum);

    // op0 (000): X + Y + Z
    Add16(a=xySum, b=z, out=op0);

    // op1 (001): (X AND Y) OR Z
    Or16(a=xyAnd, b=z, out=op1);

    // op2 (010): (X OR Y) AND Z
    And16(a=xyOr, b=z, out=op2);

    // op3 (011): X AND Y AND Z
    And16(a=xyAnd, b=z, out=op3);

    // op4 (100): X OR Y OR Z
    Or16(a=xyOr, b=z, out=op4);

    // op5 (101): X + Y - Z
    Not16(in=z, out=notZ);
    Inc16(in=notZ, out=negZ);
    Add16(a=xySum, b=negZ, out=op5);

    // op6 (110): (NOT X) AND Y AND Z
    Not16(in=x, out=notX);
    And16(a=notX, b=y, out=notXAndY);
    And16(a=notXAndY, b=z, out=op6);

    // op7 (111): -(X + Y + Z)
    Not16(in=op0, out=notOp0);
    Inc16(in=notOp0, out=op7);

    // Seleccion final: asigna resultado a "muxOut" (interno) y a "out" (salida del chip)
    Mux8Way16(a=op0, b=op1, c=op2, d=op3, e=op4, f=op5, g=op6, h=op7,
               sel=opcode, out=muxOut, out=out);

    // Banderas calculadas sobre el bus interno muxOut
    Or8Way(in=muxOut[0..7], out=zrA);
    Or8Way(in=muxOut[8..15], out=zrB);
    Or(a=zrA, b=zrB, out=anyBitSet);
    Not(in=anyBitSet, out=zr);

    And(a=muxOut[15], b=muxOut[15], out=ng);
}
