// ALU3.hdl
//
// Objetivo 2 - ALU no convencional de tres operandos de entrada (X, Y, Z)
// de 16 bits, seleccionada por un codigo de operacion de 3 bits (8 operaciones).
//
// NOTA IMPORTANTE: este simulador no permite recortar bits (sub-bus) de
// una señal INTERNA: "sub bus of an internal node may not be used". Solo
// se pueden recortar pines IN/OUT del chip o las salidas de una PARTE en
// el momento de conectarlas. Por eso zr y ng se derivan de sub-buses
// tomados directamente en la conexion de salida del Mux8Way16.
//
// Tabla de operaciones (ver tambien README.md de esta carpeta):
//   opcode | operacion
//   000    | X + Y + Z
//   001    | (X AND Y) OR Z
//   010    | (X OR Y) AND Z
//   011    | X AND Y AND Z
//   100    | X OR Y OR Z
//   101    | X + Y - Z
//   110    | (NOT X) AND Y AND Z
//   111    | -(X + Y + Z)

CHIP ALU3 {
    IN
        x[16], y[16], z[16],
        opcode[3];

    OUT
        out[16],
        zr,
        ng;

    PARTS:
    // Subexpresiones compartidas entre operaciones (reduce compuertas)
    And16(a=x, b=y, out=xyAnd);
    Or16(a=x, b=y, out=xyOr);
    Add16(a=x, b=y, out=xySum);

    // op0 (000): X + Y + Z
    Add16(a=xySum, b=z, out=op0);

    // op1 (001): (X AND Y) OR Z
    Or16(a=xyAnd, b=z, out=op1);

    // op2 (010): (X OR Y) AND Z
    And16(a=xyOr, b=z, out=op2);

    // op3 (011): X AND Y AND Z
    And16(a=xyAnd, b=z, out=op3);

    // op4 (100): X OR Y OR Z
    Or16(a=xyOr, b=z, out=op4);

    // op5 (101): X + Y - Z  (complemento a dos: X + Y + (NOT Z + 1))
    Not16(in=z, out=notZ);
    Inc16(in=notZ, out=negZ);
    Add16(a=xySum, b=negZ, out=op5);

    // op6 (110): (NOT X) AND Y AND Z
    Not16(in=x, out=notX);
    And16(a=notX, b=y, out=notXAndY);
    And16(a=notXAndY, b=z, out=op6);

    // op7 (111): -(X + Y + Z)  (complemento a dos de op0)
    Not16(in=op0, out=notOp0);
    Inc16(in=notOp0, out=op7);

    // Seleccion final segun opcode. El resultado se conecta de una vez al
    // pin OUT y, en paralelo, se extraen el bit de signo y los dos bytes
    // que necesita zr. Recortar bits AQUI es legal porque la fuente es la
    // salida de una PARTE (el Mux8Way16), no una señal interna guardada.
    Mux8Way16(a=op0, b=op1, c=op2, d=op3, e=op4, f=op5, g=op6, h=op7,
              sel=opcode,
              out=out,
              out[0..7]=resByte0,
              out[8..15]=resByte1,
              out[15]=ng);

    // zr: 1 solo si los 16 bits del resultado son cero
    Or8Way(in=resByte0, out=any0);
    Or8Way(in=resByte1, out=any1);
    Or(a=any0, b=any1, out=anyBitSet);
    Not(in=anyBitSet, out=zr);
}
